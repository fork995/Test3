# Copy outside the repository and restrict to the backend user.
ADMIN_PASSWORD_HASH_FILE=/home/admin/clevervet-runtime/admin-password.hash
BROWSER_LAUNCH_SCRIPT=/home/admin/clevervet-runtime/photo-backend/deploy/browser-session.sh
BROWSER_OPEN_URL_SCRIPT=/home/admin/clevervet-runtime/photo-backend/deploy/browser-open-url.sh
ADMIN_BROWSER_MINUTES=30

# Set only after the Auth0 tenant owner authorizes this backend client and
# allowlists http://localhost:8788/admin/oidc/callback for it.
# OIDC_CLIENT_ID=APPROVED_BACKEND_CLIENT_ID
# For confidential clients only: file must be private (0600).
# OIDC_CLIENT_SECRET_FILE=/home/admin/clevervet-runtime/oidc-client-secret
